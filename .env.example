# ===== DeepSeek（OpenAI 兼容）API 配置 =====
# 到 https://platform.deepseek.com 申请 API Key 后填入
DEEPSEEK_API_KEY=
# DeepSeek 的 OpenAI 兼容地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 对话模型
LLM_MODEL=deepseek-chat
# 温度：知识库问答建议 0.1~0.3，越低越稳定
LLM_TEMPERATURE=0.2

# ===== Embedding 模型 =====
# DeepSeek 目前不提供 embedding 接口，这里用「哈希嵌入」作为可离线复现的默认实现。
# 有真实 embedding API 时可替换（见 README「接入真实 Embedding」）
EMBEDDING_BACKEND=hash

# ===== 向量库 =====
VECTOR_DIR=data/vector_store

# ===== 知识库文档目录（放 .md/.txt/.pdf 文件）=====
DOCS_DIR=data/docs
